package binding

import micronaut.test.junit5.MicronautTest

@MicronautTest(startApplication: false, transactional: false)
class ApplicationTest {
}

Void main() {
  require(condition: ApplicationTest.class.annotation<MicronautTest>() != null, message: "MicronautTest binding is missing")
  printLine("Micronaut test context")
}
